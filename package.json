{
  "name": "masterwork",
  "version": "0.1.0",
  "description": "A local workbench for AI-coding agent skills and subagents — browse, edit, AI-refine, and prove them with scored simulation runs.",
  "license": "Elastic-2.0",
  "type": "module",
  "bin": {
    "masterwork": "bin/masterwork.mjs"
  },
  "scripts": {
    "start": "node bin/masterwork.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flieks/masterwork.git"
  },
  "keywords": [
    "claude-code",
    "agent-skills",
    "skill-md",
    "ai-agents",
    "developer-tools"
  ],
  "files": [
    "bin",
    "backend",
    "frontend",
    "README.md",
    "LICENSE",
    "!**/tests/**",
    "!**/__pycache__/**",
    "!**/*.pyc",
    "!**/.pytest_cache/**",
    "!**/.ruff_cache/**",
    "!**/.mypy_cache/**",
    "!backend/.venv/**",
    "!frontend/playwright/**",
    "!frontend/playwright*.config.ts",
    "!frontend/tsconfig.test.json",
    "!frontend/tsconfig.client.json",
    "!frontend/eslint.config.js",
    "!**/*.db"
  ]
}
