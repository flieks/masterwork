{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "backend",
        "uvicorn",
        "app.main:app",
        "--port",
        "8008"
      ],
      "port": 8008
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5192
    },
    {
      "name": "backend-verify",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "CORS_ORIGINS=http://localhost:5201",
        "uv",
        "run",
        "--directory",
        "backend",
        "uvicorn",
        "app.main:app",
        "--port",
        "8013"
      ],
      "port": 8013
    },
    {
      "name": "frontend-verify",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_API_URL=http://localhost:8013",
        "npm",
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5201",
        "--strictPort"
      ],
      "port": 5201
    }
  ]
}
