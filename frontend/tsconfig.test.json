{
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "baseUrl": ".",
    "paths": { "~/*": ["./src/*"] },
    "types": ["node"]
  },
  "include": ["src", "tests", "playwright.config.ts", "playwright-ct.config.ts", "playwright"],
  "exclude": ["src/api/generated"]
}
