# Database. Defaults to SQLite at ~/.masterwork/masterwork.db — no server to
# install, nothing to configure. Uncomment to use Postgres instead (same
# migrations work on both); the URL below assumes the OS user, no password.
# DATABASE_URL=postgresql+asyncpg://localhost:5432/masterwork

# Comma-separated list of allowed CORS origins (the Vite frontend).
CORS_ORIGINS=http://localhost:5192

# Claude Code CLI used by the chat runner (subscription, no API key).
CLAUDE_BIN=claude
# Authoring (chat, simulations, trigger guide, generality audit).
CLAUDE_MODEL=fable
# Derivative output (project summaries, asset diagrams).
CLAUDE_LIGHT_MODEL=opus
CLAUDE_TIMEOUT_SECONDS=300

# Global instructions file shown under /instructions (default ~/.claude/CLAUDE.md).
# CLAUDE_INSTRUCTIONS_FILE=
